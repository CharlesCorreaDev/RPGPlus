    { "type": "text", "weight": 1, "range": [6,6], "name": "Quebrar uma maldição antiga", "img": "icons/svg/terror.svg", "description": "<p>A maldição se adapta a quem tenta quebrá-la.</p>", "drawn": false, "flags": {}, "documentUuid": null },
    { "type": "text", "weight": 1, "range": [7,7], "name": "Identificar o traidor", "img": "icons/svg/terror.svg", "description": "<p>Alguém próximo está colaborando com o horror.</p>", "drawn": false, "flags": {}, "documentUuid": null },
    { "type": "text", "weight": 1, "range": [8,8], "name": "Conter uma entidade libertada por erro", "img": "icons/svg/terror.svg", "description": "<p>Algo foi solto e não entende o mundo atual.</p>", "drawn": false, "flags": {}, "documentUuid": null },
    { "type": "text", "weight": 1, "range": [9,9], "name": "Sobreviver até o amanhecer", "img": "icons/svg/terror.svg", "description": "<p>O tempo é o verdadeiro inimigo.</p>", "drawn": false, "flags": {}, "documentUuid": null },
