    { "type": "text", "weight": 1, "range": [3,3], "name": "Recuperar um artefato antigo", "img": "icons/svg/terror.svg", "description": "<p>O objeto não deve ser usado, estudado ou sequer tocado.</p>", "drawn": false, "flags": {}, "documentUuid": null },
    { "type": "text", "weight": 1, "range": [4,4], "name": "Silenciar uma verdade proibida", "img": "icons/svg/terror.svg", "description": "<p>Algumas verdades destroem tudo quando reveladas.</p>", "drawn": false, "flags": {}, "documentUuid": null },
